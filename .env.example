# ==========================================
# SeatFlow Infrastructure Environment Template
# ==========================================
# Copy to .env for local development. Never commit .env with real secrets.
# Production uses GCP Secret Manager / GitHub Environments and AR_BASE + SEATFLOW_IMAGE_TAG.

# PostgreSQL Configuration (shared server, 7 logical databases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_USERNAME=seatflow
DB_PASSWORD=seatflow_dev
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration (local compose uses redis:6379; localhost for IDE)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Gateway RedisRateLimiter Configuration
RATE_LIMIT_REPLENISH_RATE=20
RATE_LIMIT_BURST_CAPACITY=40
RATE_LIMIT_REQUESTED_TOKENS=1
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# Realtime Redis Pub/Sub Configuration
REALTIME_REDIS_CHANNEL=seatflow:realtime:seat-status
REALTIME_INSTANCE_ID=

# Kafka Configuration (KRaft, single-node)
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Docker DNS: KAFKA_BOOTSTRAP_SERVERS=kafka:9092 when SPRING_PROFILES_ACTIVE=docker

# Observability Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_TOKEN_FILE=./prometheus/prometheus-scrape-token.example
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_TRACES_SAMPLER_ARG=1.0
TEMPO_PORT=3200
LOKI_PORT=3100
SEATFLOW_DEPLOYMENT_ENV=docker
SEATFLOW_VERSION=dev

# Service Registry & Gateway Ports
EUREKA_SERVER_PORT=8761
GATEWAY_PORT=8080
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Microservices Network Ports
USER_SERVICE_PORT=8081
SEAT_MAP_SERVICE_PORT=8082
EVENT_SERVICE_PORT=8083
RESERVATION_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
TICKET_SERVICE_PORT=8086
REALTIME_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
FRONTEND_PORT=4200

# Production Image Registry (Artifact Registry)
# Example: us-central1-docker.pkg.dev/my-project/seatflow
AR_BASE=example.invalid/seatflow
SEATFLOW_IMAGE_TAG=local
# Required in prod: SEATFLOW_IMAGE_TAG must be an immutable Git SHA / release tag (e.g. sha-abc123)

# Supabase Auth (OIDC / JWT)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=https://txyyirobwnomhxygbacq.supabase.co/auth/v1/.well-known/jwks.json
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://txyyirobwnomhxygbacq.supabase.co/auth/v1
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=authenticated
SUPABASE_URL=https://txyyirobwnomhxygbacq.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Sandbox (Test Keys)
STRIPE_API_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PUBLISHABLE_KEY=pk_test_dummy

# Allowed CORS origins (local vs prod)
ALLOWED_ORIGINS=http://localhost:4200
# Prod: ALLOWED_ORIGINS=https://seatflow.app
