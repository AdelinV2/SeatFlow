# ====================================================================
# notification-service Environment Variables Template
# Copy this file to .env and update values for local development.
# .env is strictly .gitignored — never commit real credentials.
# ====================================================================

# Spring Profile & Server
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8088
EUREKA_URI=http://localhost:8761/eureka

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatflow_notification
DB_USERNAME=seatflow
DB_PASSWORD=seatflow_dev

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=notification-service

# Inter-Service URLs
TICKET_SERVICE_URL=http://localhost:8086

# Mail Provider Configuration (Resend SMTP & REST)
RESEND_API_KEY=re_dummy_test_key
RESEND_FROM_EMAIL=SeatFlow Tickets <tickets@seat-flow.me>
RESEND_API_URL=https://api.resend.com

MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_dummy_test_key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=SeatFlow Tickets <tickets@seat-flow.me>

# Notification Retry Scheduler Configuration
NOTIFICATION_RETRY_INTERVAL_MS=30000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BATCH_SIZE=50

# Security (Microsoft Entra ID CIAM)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://seatflow.ciamlogin.com/dummy/v2.0
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=api://seatflow-backend
