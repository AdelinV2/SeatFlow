# ====================================================================
# analytics-service Environment Variables Template
# Copy this file to .env and update values for local development.
# .env is strictly .gitignored — never commit real credentials.
#
# Stripe-derived financial data in this service is analytics over
# Stripe Test Mode / Demo transactions only.
# ====================================================================

# Spring Profile & Server
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8089
EUREKA_URI=http://localhost:8761/eureka

# Database (PostgreSQL — analytics read model only, never another service DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatflow_analytics
DB_USERNAME=seatflow
DB_PASSWORD=seatflow_dev

# Kafka (brand-new consumer group seeds from retained history; auto-commit stays disabled)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=analytics-service-v1

# Security (Microsoft Entra ID CIAM)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://txyyirobwnomhxygbacq.supabase.co/auth/v1
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=authenticated
