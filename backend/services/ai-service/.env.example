# ====================================================================
# ai-service Environment Variables Template (TASK-P15-001)
# Copy this file to .env and update values for local development.
# .env is strictly .gitignored — never commit real credentials.
#
# Manual Groq setup for a live-provider smoke test (project owner only):
#   1. create/sign in to Groq Cloud (https://console.groq.com);
#   2. create an API key;
#   3. put it in the local non-versioned .env as GROQ_API_KEY (never commit);
#   4. set AI_ENABLED=true only when a valid key is present;
#   5. for the public demo deployment, add GROQ_API_KEY to the production
#      host/runtime secret environment, never to committed .env files.
# ====================================================================

# Spring Profile & Server
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8090
EUREKA_URI=http://localhost:8761/eureka

# AI feature flag (default false: SeatFlow starts without a Groq key)
AI_ENABLED=false

# Groq provider via Spring AI OpenAI-compatible client (Spring AI 2.0.1).
# GROQ_API_KEY has no default credential value on purpose.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Security (Microsoft Entra ID CIAM / Supabase OIDC in local compose)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://txyyirobwnomhxygbacq.supabase.co/auth/v1
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=authenticated

# Event Service discovery override for AI read-only tools (TASK-P15-002).
# Defaults to the Eureka logical name; override only for direct local debugging.
EVENT_SERVICE_URL=http://event-service

# Reservation Service discovery override for AI seat tools (TASK-P15-003).
# Defaults to the Eureka logical name; override only for direct local debugging.
RESERVATION_SERVICE_URL=http://reservation-service

# Assistant conversation memory bounds (TASK-P15-004 section 4).
# All three are configurable with validation and safe upper bounds.
AI_CHAT_MAX_MESSAGES=24
AI_CONVERSATION_TTL=30m
AI_MAX_ACTIVE_CONVERSATIONS=500

# Cadence of the bounded expired-conversation sweep (ISO-8601 duration, default PT5M).
AI_CONVERSATION_CLEANUP_INTERVAL=PT5M

# Secure reservation-proposal bounds (TASK-P15-005 section 5).
# Both are configurable with validation and safe upper bounds. The 5-minute proposal TTL is
# explicitly not a seat hold; seats stay free until Reservation Service creates the hold.
AI_PROPOSAL_TTL=5m
AI_MAX_ACTIVE_PROPOSALS=500

# Cadence of the bounded expired-proposal sweep (ISO-8601 duration, default PT1M).
AI_PROPOSAL_CLEANUP_INTERVAL=PT1M
