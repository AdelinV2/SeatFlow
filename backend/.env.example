# =============================================================================
# SeatFlow Backend — Common Environment Variable Template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in each microservice directory and adjust values.
# Real `.env` files are local-only and strictly git-ignored. In Staging/Prod,
# these variables are injected via GCP Secret Manager and GitHub Environments.
# =============================================================================

# --- Application ---
SEATFLOW_ENV=local
SPRING_PROFILES_ACTIVE=local
LOGGING_FORMAT=console

# --- Eureka (Service Discovery) ---
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_CLIENT_ENABLED=true

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatflow
DB_USER=seatflow
DB_PASSWORD=seatflow
DB_SCHEMA=public

# --- Kafka ---
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis (cache / distributed lock) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Observability ---
PROMETHEUS_ENABLED=true
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# --- Security (OAuth2 / OIDC — Microsoft Entra External ID) ---
OIDC_ISSUER_URI=https://your-tenant.b2clogin.com/your-tenant/v2.0/
OIDC_CLIENT_ID=seatflow-backend
OIDC_AUDIENCE=seatflow-api
