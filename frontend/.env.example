NG_APP_API_BASE_URL=/api
NG_APP_WS_URL=/ws
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Local IDE: Angular proxy (proxy.conf.json) forwards /api and /ws to http://localhost:8080
# Docker/Prod: Nginx edge proxies /api/ -> http://api-gateway:8080 and /ws/ with WebSocket upgrade.
# Keep runtime Stripe publishable key in sync with public/env.js and payment-service STRIPE_API_KEY (same Stripe account, test mode).
